{
  "title": "AeroScrape",
  "uid": "aeroscrape",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "30s",
  "tags": [
    "aeroscrape"
  ],
  "timezone": "browser",
  "panels": [
    {
      "type": "row",
      "title": "API",
      "id": 1,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Requests per second",
      "id": 2,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (handler) (rate(http_requests_total{job=\"api\"}[1m]))",
          "legendFormat": "{{handler}}",
          "refId": "A"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "type": "timeseries",
      "title": "Latency",
      "id": 3,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Alert at p95 above 500 ms for 10 minutes",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.5, sum by (le) (rate(http_request_duration_highr_seconds_bucket{job=\"api\"}[5m])))",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_highr_seconds_bucket{job=\"api\"}[5m])))",
          "legendFormat": "p95",
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.99, sum by (le) (rate(http_request_duration_highr_seconds_bucket{job=\"api\"}[5m])))",
          "legendFormat": "p99",
          "refId": "C"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "type": "timeseries",
      "title": "Error rate",
      "id": 4,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Alert at 5xx above 5% for 10 minutes. 4xx are rejected requests (bad key, invalid input).",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "(sum(rate(http_requests_total{job=\"api\", status=\"5xx\"}[5m])) or vector(0)) / sum(rate(http_requests_total{job=\"api\"}[5m]))",
          "legendFormat": "5xx",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "(sum(rate(http_requests_total{job=\"api\", status=\"4xx\"}[5m])) or vector(0)) / sum(rate(http_requests_total{job=\"api\"}[5m]))",
          "legendFormat": "4xx",
          "refId": "B"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 5,
        "x": 16,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "custom": {
            "axisSoftMax": 0.05
          }
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "type": "stat",
      "title": "Served model",
      "id": 5,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "model_version_info{job=\"api\"}",
          "legendFormat": "version {{version}} ({{variant}})",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 3,
        "x": 21,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "textMode": "name",
        "colorMode": "none",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "type": "row",
      "title": "Predictions",
      "id": 6,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 9
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Flights scored per airport",
      "id": 7,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Per minute, without load-test traffic",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (airport) (rate(predictions_total{traffic_source!=\"loadtest\"}[5m])) * 60",
          "legendFormat": "{{airport}}",
          "refId": "A"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 9,
        "x": 0,
        "y": 10
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "stacking": {
              "mode": "normal"
            },
            "fillOpacity": 30
          },
          "unit": "short"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "type": "timeseries",
      "title": "Predicted delay",
      "id": 8,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.5, sum by (le) (rate(predicted_delay_minutes_bucket[15m])))",
          "legendFormat": "median of predicted delays",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.9, sum by (le) (rate(predicted_delay_minutes_bucket[15m])))",
          "legendFormat": "90th percentile",
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(predictions_total{likely_delayed=\"true\"}[15m])) / sum(rate(predictions_total[15m]))",
          "legendFormat": "share flagged likely delayed",
          "refId": "C"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 9,
        "y": 10
      },
      "fieldConfig": {
        "defaults": {
          "unit": "m"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "share flagged likely delayed"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percentunit"
              },
              {
                "id": "custom.axisPlacement",
                "value": "right"
              }
            ]
          }
        ]
      },
      "options": {}
    },
    {
      "type": "timeseries",
      "title": "Input problems",
      "id": 9,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Per minute: values the model never saw, requested flights not among scraped flights, lookups that fell back to request fields",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (column) (rate(unseen_categories_total[15m])) * 60",
          "legendFormat": "unseen {{column}}",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "rate(unmatched_flights_total[15m]) * 60",
          "legendFormat": "flight not found",
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "rate(feature_lookup_failures_total[15m]) * 60",
          "legendFormat": "lookup failed",
          "refId": "C"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 7,
        "x": 17,
        "y": 10
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "type": "row",
      "title": "Ingest",
      "id": 10,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 18
      },
      "panels": []
    },
    {
      "type": "bargauge",
      "title": "Rows scraped per airport, last run",
      "id": 11,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Red: no rows. AirportBoardEmpty fires when an airport that had flights this week returns none.",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sort_desc(scraped_rows)",
          "legendFormat": "{{airport}}",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "gridPos": {
        "h": 10,
        "w": 16,
        "x": 0,
        "y": 19
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "basic",
        "showUnfilled": true,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "type": "stat",
      "title": "Since the last successful load",
      "id": 12,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "time() - ingest_last_success_timestamp_seconds",
          "legendFormat": "",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 16,
        "y": 19
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "#EAB839",
                "value": 14400
              },
              {
                "color": "red",
                "value": 25200
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none"
      }
    },
    {
      "type": "stat",
      "title": "Last load",
      "id": 13,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "ingest_rows_loaded",
          "legendFormat": "loaded",
          "refId": "A",
          "instant": true,
          "range": false
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "ingest_rows_rejected",
          "legendFormat": "rejected",
          "refId": "B",
          "instant": true,
          "range": false
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "ingest_rows_skipped",
          "legendFormat": "skipped",
          "refId": "C",
          "instant": true,
          "range": false
        }
      ],
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 20,
        "y": 19
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value_and_name"
      }
    },
    {
      "type": "table",
      "title": "Firing alerts",
      "id": 14,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "ALERTS{alertstate=\"firing\"}",
          "legendFormat": "",
          "refId": "A",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "gridPos": {
        "h": 5,
        "w": 8,
        "x": 16,
        "y": 24
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {},
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Value": true,
              "__name__": true,
              "alertstate": true,
              "instance": true
            }
          }
        }
      ]
    },
    {
      "type": "row",
      "title": "Model quality (daily, from the monitor DAG)",
      "id": 15,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 29
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Live vs. offline MAE",
      "id": 16,
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "flightdb"
      },
      "description": "Median prediction against the actual delay. A day more than 25% above offline counts as degraded; 3 in a row fire LiveMaeDegraded and trigger retraining.",
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "flightdb"
          },
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT day::timestamp AS time, 'live, version ' || model_version AS metric, mae AS value FROM live_metrics_daily WHERE mae IS NOT NULL ORDER BY 1",
          "format": "time_series",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "flightdb"
          },
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT day::timestamp AS time, 'offline, version ' || model_version AS metric, offline_mae AS value FROM live_metrics_daily WHERE offline_mae IS NOT NULL ORDER BY 1",
          "format": "time_series",
          "refId": "B"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 30
      },
      "fieldConfig": {
        "defaults": {
          "unit": "m",
          "custom": {
            "drawStyle": "line",
            "showPoints": "always",
            "spanNulls": true,
            "pointSize": 7,
            "lineWidth": 2
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": "offline.*"
            },
            "properties": [
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash",
                  "dash": [
                    10,
                    10
                  ]
                }
              }
            ]
          }
        ]
      },
      "options": {},
      "timeFrom": "14d",
      "hideTimeOverride": false
    },
    {
      "type": "timeseries",
      "title": "Live vs. offline Brier score",
      "id": 17,
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "flightdb"
      },
      "description": "Delay probability against whether the flight left more than 15 minutes late; lower is better",
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "flightdb"
          },
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT day::timestamp AS time, 'live, version ' || model_version AS metric, brier AS value FROM live_metrics_daily WHERE brier IS NOT NULL ORDER BY 1",
          "format": "time_series",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "flightdb"
          },
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT day::timestamp AS time, 'offline, version ' || model_version AS metric, offline_brier AS value FROM live_metrics_daily WHERE offline_brier IS NOT NULL ORDER BY 1",
          "format": "time_series",
          "refId": "B"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 30
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {
            "drawStyle": "line",
            "showPoints": "always",
            "spanNulls": true,
            "pointSize": 7,
            "lineWidth": 2
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": "offline.*"
            },
            "properties": [
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash",
                  "dash": [
                    10,
                    10
                  ]
                }
              }
            ]
          }
        ]
      },
      "options": {},
      "timeFrom": "14d",
      "hideTimeOverride": false
    },
    {
      "type": "timeseries",
      "title": "Live vs. offline coverage of the 10-90% range",
      "id": 18,
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "flightdb"
      },
      "description": "Should be near 80%; below 65% fires LiveCoverageLow",
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "flightdb"
          },
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT day::timestamp AS time, 'live, version ' || model_version AS metric, coverage AS value FROM live_metrics_daily WHERE coverage IS NOT NULL ORDER BY 1",
          "format": "time_series",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "flightdb"
          },
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT day::timestamp AS time, 'offline, version ' || model_version AS metric, offline_coverage AS value FROM live_metrics_daily WHERE offline_coverage IS NOT NULL ORDER BY 1",
          "format": "time_series",
          "refId": "B"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 30
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "drawStyle": "line",
            "showPoints": "always",
            "spanNulls": true,
            "pointSize": 7,
            "lineWidth": 2
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": "offline.*"
            },
            "properties": [
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash",
                  "dash": [
                    10,
                    10
                  ]
                }
              }
            ]
          }
        ]
      },
      "options": {},
      "timeFrom": "14d",
      "hideTimeOverride": false
    },
    {
      "type": "bargauge",
      "title": "Input drift (PSI, last 7 days vs. training)",
      "id": 19,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "0.1 is a moderate shift, 0.25 a large one (InputDrift fires). The full report is in reports/monitoring and in MLflow.",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sort_desc(feature_drift_psi)",
          "legendFormat": "{{feature}}",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 10,
        "x": 0,
        "y": 38
      },
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 1,
          "decimals": 3,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "#EAB839",
                "value": 0.1
              },
              {
                "color": "red",
                "value": 0.25
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "basic",
        "showUnfilled": true,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "type": "table",
      "title": "Daily live metrics",
      "id": 20,
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "flightdb"
      },
      "description": "",
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "flightdb"
          },
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT to_char(day, 'YYYY-MM-DD') AS day, model_version AS version, predicted_flights AS flights, matched_flights AS matched, round(mae::numeric, 1) AS mae, round(offline_mae::numeric, 1) AS \"offline mae\", round(brier::numeric, 3) AS brier, round(coverage::numeric, 2) AS coverage, round(no_inbound_share::numeric, 2) AS \"no inbound\" FROM live_metrics_daily ORDER BY day DESC, model_version DESC LIMIT 30",
          "format": "table",
          "refId": "A"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 14,
        "x": 10,
        "y": 38
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "minWidth": 60,
            "align": "auto"
          }
        },
        "overrides": []
      },
      "options": {}

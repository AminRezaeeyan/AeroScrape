DB_NAME=flights
DB_USER=aeroscrape_admin
DB_PASSWORD=SET_YOUR_DB_PASSWORD
DB_HOST=db
# Port inside the Docker network; containers always use 5432
DB_PORT=5432
# Port published on your machine, for tools like psql or DBeaver
DB_HOST_PORT=5433

# Airflow metadata database, created next to DB_NAME on the same server
AIRFLOW_DB_NAME=airflow

# Airflow web UI admin, created on first start
AIRFLOW_ADMIN_USER=airflow_admin
AIRFLOW_ADMIN_PASSWORD=SET_YOUR_ADMIN_PASSWORD
AIRFLOW_ADMIN_EMAIL=admin@example.com

# Limited database user, see README
APP_DB_USER=aeroscrape_app
APP_DB_PASSWORD=SET_YOUR_APP_DB_PASSWORD

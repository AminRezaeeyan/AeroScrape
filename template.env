# Postgres bootstrap superuser. Only the db container sees this; no service connects with it.
DB_ADMIN_USER=aeroscrape_admin
DB_ADMIN_PASSWORD=SET_YOUR_ADMIN_PASSWORD

# Limited role used by the application: reads and writes flight data, can't change the schema
DB_NAME=flights
DB_USER=aeroscrape_app
DB_PASSWORD=SET_YOUR_APP_PASSWORD
DB_HOST=db
# Read-only role used by the API's feature lookup
DB_READER_USER=aeroscrape_reader
DB_READER_PASSWORD=SET_YOUR_READER_PASSWORD
# Port inside the Docker network; containers always use 5432
DB_PORT=5432
# Port published on your machine, for tools like psql or DBeaver
DB_HOST_PORT=5433

# Role that owns the Airflow metadata database
AIRFLOW_DB_NAME=airflow
AIRFLOW_DB_USER=airflow_user
AIRFLOW_DB_PASSWORD=SET_YOUR_AIRFLOW_DB_PASSWORD

# Airflow web UI login
AIRFLOW_ADMIN_USER=airflow_admin
AIRFLOW_ADMIN_PASSWORD=SET_YOUR_AIRFLOW_UI_PASSWORD
AIRFLOW_ADMIN_EMAIL=admin@example.com

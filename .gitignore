# Python generated files
__pycache__/
*.pyc
*.pyo
*.pyd

# Virtual environment directories
/venv/
/flight_env/ # Your Python virtual environment folder

# Log files
/logs/ # Ignore the entire logs directory
*.log  # Ignore any .log files elsewhere

# Database specific files
# This is for any SQLite or other local database files created directly within the project
*.sqlite
*.db

# Environment variable files with secrets
.env                 # IGNORE the actual .env file which contains secrets

# Docker specific (useful even if not using Docker now, for future-proofing)
*.egg-info/          # Python distribution metadata
build/               # Build artifacts
dist/                # Distribution packages

# IDE and Editor specific files
.idea/               # JetBrains IDEs (e.g., PyCharm)
.vscode/             # VS Code settings
.DS_Store            # macOS specific files
*.swp                # Vim swap files
*.bak                # Backup files
*.tmp                # Temporary files

# Test and Linting caches/reports
.mypy_cache/         # Mypy static type checker cache
.pytest_cache/       # Pytest cache directory
.ruff_cache/         # Ruff linter cache
htmlcov/             # Coverage reports

# MLflow generated data
/mlruns/             # IGNORE the entire MLflow tracking and artifact store directory

webserver.pid        # Airflow webserver PID file
scheduler.pid        # Airflow scheduler PID file
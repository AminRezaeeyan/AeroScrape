# Python Generated Files

__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/
build/
dist/
.mypy_cache/
.pytest_cache/
.ruff_cache/
htmlcov/

# Virtual Environments
/venv/
/flight_env/
.env

#  Dynamic ML & Data Artifacts (Crucial)
# Ignore raw, cleaned, mined, and processed datasets
/data/**/*.csv
/data/processed/

# Ignore local compiled model binaries and local metrics evaluations
/models/**/*.joblib
/models/**/*.json
/models/preprocessor.joblib

# Ignore the entire MLflow run database, tags, and tracking artifact logs
/mlruns/

# Logs and Process State Files
# Ignore local runtime application logs
/logs/
*.log

# Ignore Airflow runtime PID state files
*.pid

# IDE, OS, and Jupyter Notebook garbage
.idea/
.vscode/
.DS_Store
*.swp
*.bak
*.tmp
.ipynb_checkpoints/